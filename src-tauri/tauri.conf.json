{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PtraceDesk",
  "version": "0.1.0",
  "identifier": "com.gxj.ptracedesk",
  "build": {
    "frontendDist": "../dist/client",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev -- --port 1420",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Ptrace 工作台",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://mcp-prod.ptrace.cfd; img-src 'self' asset: data: https://ptrace-prod-uploads.ptrace.cfd; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "600B95ED5A130FCB3EA33BAD32181101E7E86709"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}

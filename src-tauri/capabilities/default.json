{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://mcp-prod.ptrace.cfd/**"
        }
      ]
    },
    "notification:default",
    "opener:default"
  ]
}
